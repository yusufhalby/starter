# Copy to .env for local runs. On Render, set these in the dashboard instead (never commit real values).
META_VERIFY_TOKEN=choose-a-long-random-string
META_APP_SECRET=app-secret-from-meta-app-dashboard
META_ACCESS_TOKEN=permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
GRAPH_API_VERSION=v24.0

RESEND_API_KEY=re_xxx
# Must be an address on a domain verified in Resend (onboarding@resend.dev only delivers to your own account email)
RESEND_FROM=Top Delmon <no-reply@your-verified-domain.com>

# Postgres used to make sure each WhatsApp message is handled (and emailed) only once.
# Required on Render. Use the database's *Internal* URL.
DATABASE_URL=

# Optional tuning / test overrides
RESEND_TIMEOUT_MS=10000
WHATSAPP_TIMEOUT_MS=10000
# RESEND_BASE_URL=http://127.0.0.1:4010   # point Resend at a fake server (used by the tests)
# GRAPH_BASE_URL=http://127.0.0.1:4010    # same for the WhatsApp Graph API

# true = log emails / WhatsApp replies instead of sending them (local testing)
DRY_RUN=false
PORT=3000
